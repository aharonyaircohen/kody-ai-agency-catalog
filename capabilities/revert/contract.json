{
  "input": {
    "name": "request",
    "schema": {
      "type": "object",
      "properties": {
        "pr": {
          "type": "integer",
          "description": "GitHub PR number whose branch to revert commits on."
        },
        "shas": {
          "type": "string",
          "description": "One or more commit SHAs (whitespace-separated) to revert. Each must exist in the PR branch's history."
        }
      },
      "required": [
        "pr",
        "shas"
      ],
      "additionalProperties": false
    }
  },
  "output": {
    "name": "result",
    "schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "REVERT_COMPLETED",
            "REVERT_FAILED"
          ]
        },
        "reason": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
