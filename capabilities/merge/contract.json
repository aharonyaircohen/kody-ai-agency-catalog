{
  "input": {
    "name": "request",
    "schema": {
      "type": "object",
      "properties": {
        "pr": {
          "type": "integer",
          "description": "GitHub PR number to merge. No-op (MERGE_SKIPPED) if already closed/merged; refuses (MERGE_BLOCKED) if draft, conflicting, or not yet CLEAN."
        }
      },
      "required": [
        "pr"
      ],
      "additionalProperties": false
    }
  },
  "output": {
    "name": "result",
    "schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "MERGE_COMPLETED",
            "MERGE_BLOCKED",
            "MERGE_SKIPPED"
          ]
        },
        "reason": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
