{
  "input": {
    "name": "request",
    "schema": {
      "type": "object",
      "properties": {
        "dry-run": {
          "type": "boolean",
          "description": "Print the publish plan without requiring NPM_TOKEN or publishing."
        },
        "tag": {
          "type": "string",
          "description": "npm dist-tag to publish under. Defaults to latest."
        },
        "access": {
          "type": "string",
          "description": "npm package access. Defaults to public."
        },
        "issue": {
          "type": "integer",
          "description": "Issue/PR number to post terminal notice on."
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "output": {
    "name": "result",
    "schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "NPM_PUBLISH_COMPLETED",
            "NPM_PUBLISH_FAILED"
          ]
        },
        "reason": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
