{
  "input": {
    "name": "request",
    "schema": {
      "type": "object",
      "properties": {
        "issue": {
          "type": "integer",
          "description": "GitHub issue number to classify."
        },
        "base": {
          "type": "string",
          "description": "Optional safe base branch override for manual branch targeting."
        }
      },
      "required": [
        "issue"
      ],
      "additionalProperties": false
    }
  },
  "output": {
    "name": "result",
    "schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "CLASSIFIED_AS_FEATURE",
            "CLASSIFIED_AS_BUG",
            "CLASSIFIED_AS_SPEC",
            "CLASSIFIED_AS_CHORE",
            "CLASSIFY_FAILED"
          ]
        },
        "reason": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
