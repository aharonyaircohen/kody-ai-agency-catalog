{
  "input": {
    "name": "request",
    "schema": {
      "type": "object",
      "properties": {
        "issue": {
          "type": "integer",
          "description": "GitHub issue number to reproduce."
        }
      },
      "required": [
        "issue"
      ],
      "additionalProperties": false
    }
  },
  "output": {
    "name": "result",
    "schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "REPRODUCE_COMPLETED",
            "REPRODUCE_FAILED",
            "AGENT_NOT_RUN"
          ]
        },
        "reason": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
