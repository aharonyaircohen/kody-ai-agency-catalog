{
  "input": {
    "name": "request",
    "schema": {
      "type": "object",
      "properties": {
        "dry-run": {
          "type": "boolean",
          "description": "Print plan without running deploy/notify commands."
        },
        "issue": {
          "type": "integer",
          "description": "Issue/PR number post terminal notice on. Auto-injected by dispatch."
        },
        "goal": {
          "type": "string",
          "description": "Managed goal id to report promotion PR evidence to."
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "output": {
    "name": "result",
    "schema": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
