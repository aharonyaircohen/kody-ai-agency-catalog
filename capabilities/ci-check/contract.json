{
  "input": {
    "name": "request",
    "schema": {
      "type": "object",
      "properties": {
        "pr": {
          "type": "integer",
          "description": "Pull request number to check."
        },
        "goal": {
          "type": "string",
          "description": "Managed goal id to report CI evidence to."
        },
        "evidence": {
          "type": "string",
          "description": "Evidence key to set on the goal. Default ciGreen."
        },
        "timeout-seconds": {
          "type": "integer",
          "description": "Maximum time to wait for pending checks before reporting not-green. Default 0."
        },
        "poll-seconds": {
          "type": "integer",
          "description": "Seconds between CI polls while waiting. Default 30."
        }
      },
      "required": [
        "pr"
      ],
      "additionalProperties": false
    }
  },
  "output": {
    "name": "result",
    "schema": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
