{
  "input": {
    "name": "request",
    "schema": {
      "type": "object",
      "properties": {
        "pr": {
          "type": "integer",
          "description": "GitHub PR number whose CI is failing."
        },
        "runId": {
          "type": "string",
          "description": "Specific failed workflow run ID. Defaults to latest failed run on the PR branch."
        }
      },
      "required": [
        "pr"
      ],
      "additionalProperties": false
    }
  },
  "output": {
    "name": "result",
    "schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "FIX_CI_COMPLETED",
            "FIX_CI_FAILED",
            "AGENT_NOT_RUN"
          ]
        },
        "reason": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
