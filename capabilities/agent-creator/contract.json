{
  "input": {
    "name": "request",
    "schema": {
      "type": "object",
      "properties": {
        "issue": {
          "type": "integer",
          "description": "GitHub issue number containing the focused model creation request."
        }
      },
      "required": [
        "issue"
      ],
      "additionalProperties": false
    }
  },
  "output": {
    "name": "result",
    "schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "AGENT_CREATOR_COMPLETED",
            "AGENT_CREATOR_FAILED",
            "AGENT_NOT_RUN"
          ]
        },
        "reason": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
