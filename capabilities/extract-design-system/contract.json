{
  "input": {
    "name": "request",
    "schema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "Public URL to inspect."
        },
        "mode": {
          "type": "string",
          "description": "extract-only or starter-files. Defaults to extract-only."
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    }
  },
  "output": {
    "name": "result",
    "schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "DESIGN_SYSTEM_EXTRACTED",
            "DESIGN_SYSTEM_EXTRACT_FAILED",
            "AGENT_NOT_RUN"
          ]
        },
        "reason": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
