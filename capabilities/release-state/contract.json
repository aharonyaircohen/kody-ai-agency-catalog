{
  "input": {
    "name": "request",
    "schema": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "description": "Managed goal id to report release-state evidence to."
        },
        "evidence": {
          "type": "string",
          "description": "Evidence key to set on the goal. Default releaseStateObserved."
        },
        "package": {
          "type": "string",
          "description": "Package name to check in npm. Defaults to package.json name."
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "output": {
    "name": "result",
    "schema": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
