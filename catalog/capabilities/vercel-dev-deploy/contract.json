{
  "execution": "script",
  "secrets": [
    "VERCEL_ACCESS_TOKEN",
    "VERCEL_ORG_ID",
    "VERCEL_PROJECT_ID"
  ],
  "input": {
    "type": "object",
    "properties": {
      "target": {
        "type": "string",
        "default": "preview",
        "description": "Vercel environment target, for example preview or dev"
      },
      "devUrl": {
        "type": "string",
        "format": "uri",
        "description": "Optional stable development URL to assign after deployment"
      }
    },
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "version": { "const": 1 },
      "status": {
        "enum": ["pass", "fail", "blocked", "changed", "noop"]
      },
      "summary": { "type": "string" },
      "evidence": { "type": "object" },
      "facts": { "type": "object" },
      "artifacts": { "type": "array" },
      "missingEvidence": { "type": "array" },
      "blockers": { "type": "array" }
    },
    "required": [
      "version",
      "status",
      "summary",
      "facts",
      "artifacts",
      "missingEvidence",
      "blockers"
    ]
  }
}
