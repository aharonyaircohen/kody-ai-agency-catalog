        "type": "string",
        "format": "uri"
      }
    },
    "required": ["pr"],
    "additionalProperties": true
  },
  "output": {
    "type": "object",
    "properties": {
      "verdict": {
        "enum": ["pass", "fix"]
      },
      "feedback": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      }
    },
    "required": ["verdict", "feedback", "summary"],
    "additionalProperties": false
  }
}
