{
  "execution": "script",
  "timeoutMs": 3600000,
  "input": {
    "type": "object",
    "properties": {
      "repeat": { "type": "integer", "minimum": 1, "maximum": 3 },
      "slowTestMs": { "type": "integer", "minimum": 1000 }
    },
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "status": { "enum": ["healthy", "concern", "red", "blocked"] },
      "needsRepair": { "type": "boolean" },
      "issue": { "type": "integer", "minimum": 1 },
      "summary": { "type": "string" },
      "facts": { "type": "object" },
      "blockers": { "type": "array", "items": { "type": "string" } }
    },
    "required": ["status", "needsRepair", "summary", "facts", "blockers"],
    "additionalProperties": false
  }
}
