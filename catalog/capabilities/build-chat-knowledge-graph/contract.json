{
  "execution": "agent",
  "input": {
    "type": "object",
    "properties": {
      "companyInstructions": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      },
      "companyQuestions": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^CUSTOM-[0-9]{2}$"
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "expectedAnswer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "sourceKinds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            }
          },
          "required": ["id", "question", "expectedAnswer", "sourceKinds"],
          "additionalProperties": false
        }
      },
      "approvedSources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "locator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "purpose": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": ["kind", "locator", "purpose"],
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "schemaVersion": {
        "const": 1
      },
      "kind": {
        "const": "chat-knowledge-graph"
      },
      "status": {
        "enum": ["built", "blocked"]
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "graph": {
        "type": "object",
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "sourceIds": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              },
              "required": ["id", "type", "label", "summary", "sourceIds"],
              "additionalProperties": false
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "target": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "relation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "sourceIds": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              },
              "required": ["source", "target", "relation", "sourceIds"],
              "additionalProperties": false
            }
          }
        },
        "required": ["nodes", "edges"],
        "additionalProperties": false
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "locator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "observedAt": {
              "type": "string",
              "format": "date-time"
            },
            "evidence": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": ["id", "kind", "locator", "observedAt", "evidence"],
          "additionalProperties": false
        }
      },
      "coverage": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "questionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "status": {
              "enum": ["answered", "partial", "missing"]
            },
            "sourceIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          },
          "required": ["questionId", "status", "sourceIds"],
          "additionalProperties": false
        }
      },
      "gaps": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "questionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "neededSourceKinds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            }
          },
          "required": ["questionId", "reason", "neededSourceKinds"],
          "additionalProperties": false
        }
      },
      "proposedQuestions": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "expectedAnswer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "sourceKinds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            }
          },
          "required": ["question", "reason", "expectedAnswer", "sourceKinds"],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "schemaVersion",
      "kind",
      "status",
      "summary",
      "graph",
      "sources",
      "coverage",
      "gaps"
    ],
    "additionalProperties": false
  }
}
