{
  "execution": "script",
  "deliveryPathAllowlist": [
    "kody.config.json",
    ".kody-engine/definitions/loops/**"
  ],
  "deliveryConfigAllowlist": {
    "kody.config.json": [
      "company.activeAgents",
      "company.activeCapabilities",
      "company.activeWorkflows"
    ]
  },
  "input": {
    "type": "object",
    "properties": {
      "blueprintId": { "type": "string", "minLength": 1 },
      "blueprintVersion": { "type": "string", "minLength": 1 },
      "requestId": { "type": "string", "minLength": 1 },
      "outcome": { "type": "string", "minLength": 1 },
      "issue": { "type": "integer", "minimum": 1 },
      "installation": { "type": "object" }
    },
    "required": ["blueprintId", "blueprintVersion", "requestId", "outcome"],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "status": { "enum": ["ready", "blocked"] },
      "issue": { "type": "integer", "minimum": 1 },
      "pr": { "type": "integer", "minimum": 1 },
      "hasOpenPr": { "type": "boolean" },
      "summary": { "type": "string" }
    },
    "required": ["status", "hasOpenPr", "summary"],
    "additionalProperties": false
  }
}
