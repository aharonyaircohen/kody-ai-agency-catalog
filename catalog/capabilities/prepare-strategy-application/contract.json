{
  "execution": "script",
  "deliveryPolicy": "checkpoint",
  "deliveryPathAllowlist": [
    ".kody-engine/definitions/loops/**",
    "kody.config.json"
  ],
  "input": {
    "type": "object",
    "properties": {
      "blueprintId": { "type": "string", "minLength": 1 },
      "blueprintVersion": { "type": "string", "minLength": 1 },
      "requestId": { "type": "string", "minLength": 1 },
      "outcome": { "type": "string", "minLength": 1 },
      "installation": { "type": "object" }
    },
    "required": ["blueprintId", "blueprintVersion", "requestId", "outcome", "installation"],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "status": { "enum": ["ready", "blocked"] },
      "issue": { "type": "integer", "minimum": 1 },
      "summary": { "type": "string" }
    },
    "required": ["status", "summary"],
    "additionalProperties": false
  }
}
