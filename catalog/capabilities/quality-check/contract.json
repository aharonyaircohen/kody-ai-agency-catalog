{
  "execution": "agent",
  "requirements": {
    "browser": true,
    "qaCredentials": true,
    "githubTestToken": true,
    "browserOnly": true
  },
  "input": {
    "type": "object",
    "properties": {
      "qualityRunId": { "type": "string", "minLength": 1, "maxLength": 200 },
      "journey": {
        "type": "object",
        "properties": {
          "slug": { "type": "string", "minLength": 1, "maxLength": 80 },
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "goal": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "priority": { "enum": ["critical", "high", "normal"] },
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "slug": { "type": "string", "minLength": 1, "maxLength": 80 },
                "name": { "type": "string", "minLength": 1, "maxLength": 160 },
                "outcome": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "area": { "type": "string", "minLength": 1, "maxLength": 120 }
              },
              "required": ["slug", "name", "outcome", "area"],
              "additionalProperties": false
            }
          }
        },
        "required": ["slug", "name", "goal", "priority", "actions"],
        "additionalProperties": false
      },
      "scenario": {
        "type": "object",
        "properties": {
          "slug": { "type": "string", "minLength": 1, "maxLength": 80 },
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "kind": {
            "enum": [
              "happy",
              "validation",
              "permission",
              "failure",
              "recovery",
              "persistence"
            ]
          },
          "given": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "expectedVisible": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "expectedState": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "cleanup": { "type": "string", "maxLength": 4000 }
        },
        "required": [
          "slug",
          "name",
          "kind",
          "given",
          "expectedVisible",
          "expectedState"
        ],
        "additionalProperties": false
      },
      "targetUrl": { "type": "string", "format": "uri", "maxLength": 2048 },
      "sourceCommit": { "type": "string", "minLength": 7, "maxLength": 64 }
    },
    "required": [
      "qualityRunId",
      "journey",
      "scenario",
      "targetUrl",
      "sourceCommit"
    ],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "version": { "const": 1 },
      "status": { "enum": ["pass", "fail", "blocked"] },
      "summary": { "type": "string" },
      "evidence": {
        "type": "object",
        "properties": {
          "qualityTestPassed": { "type": "boolean" }
        },
        "required": ["qualityTestPassed"],
        "additionalProperties": false
      },
      "facts": {
        "type": "object",
        "properties": {
          "journeyName": { "type": "string" },
          "artifactPath": { "type": "string" },
          "artifactUrl": { "type": "string" },
          "actionResults": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "actionSlug": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "actionName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "status": { "enum": ["passed", "failed", "blocked"] },
                "evidence": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "artifactPath": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              },
              "required": [
                "actionSlug",
                "actionName",
                "status",
                "evidence",
                "artifactPath"
              ],
              "additionalProperties": false
            }
          },
          "scenarioResult": {
            "type": "object",
            "properties": {
              "status": { "enum": ["passed", "failed", "blocked"] },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "artifactPath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": ["status", "evidence", "artifactPath"],
            "additionalProperties": false
          },
          "sourceCommit": { "type": "string" }
        },
        "required": [
          "journeyName",
          "artifactPath",
          "artifactUrl",
          "actionResults",
          "scenarioResult",
          "sourceCommit"
        ],
        "additionalProperties": false
      },
      "artifacts": { "type": "array" },
      "missingEvidence": { "type": "array", "items": { "type": "string" } },
      "blockers": { "type": "array", "items": { "type": "string" } }
    },
    "required": [
      "version",
      "status",
      "summary",
      "evidence",
      "facts",
      "artifacts",
      "missingEvidence",
      "blockers"
    ],
    "additionalProperties": false
  }
}
