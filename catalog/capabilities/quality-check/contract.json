{
  "execution": "agent",
  "requirements": {
    "browser": true,
    "qaCredentials": true,
    "githubTestToken": true,
    "qaAccountCredentials": ["MINIMAX_API_KEY"],
    "qaAccountModelSettings": {
      "models": [
        {
          "id": "minimax/MiniMax-M3",
          "label": "MiniMax M3",
          "provider": "minimax",
          "adapter": "openai-compatible",
          "adapterBaseURL": "https://api.minimax.io/v1",
          "protocol": "openai",
          "baseURL": "https://api.minimax.io/v1",
          "modelName": "MiniMax-M3",
          "apiKeySecret": "MINIMAX_API_KEY",
          "enabled": true,
          "default": true
        }
      ],
      "automatic": { "default": false }
    },
    "browserOnly": true
  },
  "input": {
    "type": "object",
    "properties": {
      "qualityRunId": { "type": "string", "minLength": 1, "maxLength": 200 },
      "journeys": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "properties": {
          "slug": { "type": "string", "minLength": 1, "maxLength": 80 },
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "goal": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "priority": { "enum": ["critical", "high", "normal"] },
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "slug": { "type": "string", "minLength": 1, "maxLength": 80 },
                "name": { "type": "string", "minLength": 1, "maxLength": 160 },
                "outcome": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "area": { "type": "string", "minLength": 1, "maxLength": 120 }
              },
              "required": ["slug", "name", "outcome", "area"],
              "additionalProperties": false
            }
          }
          },
          "required": ["slug", "name", "goal", "priority", "actions"],
          "additionalProperties": false
        }
      },
      "scenario": {
        "type": "object",
        "properties": {
          "slug": { "type": "string", "minLength": 1, "maxLength": 80 },
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "kind": {
            "enum": [
              "happy",
              "validation",
              "permission",
              "failure",
              "recovery",
              "persistence"
            ]
          },
          "given": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "expectedVisible": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "expectedState": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "cleanup": { "type": "string", "maxLength": 4000 }
        },
        "required": [
          "slug",
          "name",
          "kind",
          "given",
          "expectedVisible",
          "expectedState"
        ],
        "additionalProperties": false
      },
      "targetUrl": { "type": "string", "format": "uri", "maxLength": 2048 },
      "sourceCommit": { "type": "string", "minLength": 7, "maxLength": 64 }
    },
    "required": [
      "qualityRunId",
      "journeys",
      "scenario",
      "targetUrl",
      "sourceCommit"
    ],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "version": { "const": 1 },
      "status": { "enum": ["pass", "fail", "blocked"] },
      "summary": { "type": "string" },
      "evidence": {
        "type": "object",
        "properties": {
          "qualityTestPassed": { "type": "boolean" }
        },
        "required": ["qualityTestPassed"],
        "additionalProperties": false
      },
      "facts": {
        "type": "object",
        "properties": {
          "artifactPath": { "type": "string" },
          "artifactUrl": { "type": "string" },
          "journeyResults": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "journeySlug": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "journeyName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "status": { "enum": ["passed", "failed", "blocked"] },
                "evidence": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "issueSource": {
                  "enum": ["none", "product", "test", "environment", "unknown"]
                },
                "cause": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "correction": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "artifactPath": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              },
              "required": [
                "journeySlug",
                "journeyName",
                "status",
                "evidence",
                "issueSource",
                "cause",
                "correction",
                "artifactPath"
              ],
              "additionalProperties": false
            }
          },
          "actionResults": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "journeySlug": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "actionSlug": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "actionName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "status": { "enum": ["passed", "failed", "blocked"] },
                "evidence": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "issueSource": {
                  "enum": ["none", "product", "test", "environment", "unknown"]
                },
                "cause": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "correction": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "artifactPath": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              },
              "required": [
                "journeySlug",
                "actionSlug",
                "actionName",
                "status",
                "evidence",
                "issueSource",
                "cause",
                "correction",
                "artifactPath"
              ],
              "additionalProperties": false
            }
          },
          "scenarioResult": {
            "type": "object",
            "properties": {
              "status": { "enum": ["passed", "failed", "blocked"] },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "issueSource": {
                "enum": ["none", "product", "test", "environment", "unknown"]
              },
              "cause": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "correction": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "artifactPath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": [
              "status",
              "evidence",
              "issueSource",
              "cause",
              "correction",
              "artifactPath"
            ],
            "additionalProperties": false
          },
          "sourceCommit": { "type": "string" }
        },
        "required": [
          "artifactPath",
          "artifactUrl",
          "journeyResults",
          "actionResults",
          "scenarioResult",
          "sourceCommit"
        ],
        "additionalProperties": false
      },
      "artifacts": { "type": "array" },
      "missingEvidence": { "type": "array", "items": { "type": "string" } },
      "blockers": { "type": "array", "items": { "type": "string" } }
    },
    "required": [
      "version",
      "status",
      "summary",
      "evidence",
      "facts",
      "artifacts",
      "missingEvidence",
      "blockers"
    ],
    "additionalProperties": false
  }
}
