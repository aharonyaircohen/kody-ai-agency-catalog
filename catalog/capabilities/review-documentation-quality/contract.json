{
  "execution": "agent",
  "input": {
    "type": "object",
    "properties": {
      "issue": {
        "type": "integer",
        "minimum": 1
      },
      "document": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "issue",
      "document"
    ],
    "additionalProperties": true
  },
  "output": {
    "type": "object",
    "properties": {
      "version": {
        "const": 1
      },
      "status": {
        "enum": [
          "pass",
          "changed",
          "blocked"
        ]
      },
      "findings": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "summary": {
        "type": "string"
      }
    },
    "required": [
      "version",
      "status",
      "findings",
      "summary"
    ],
    "additionalProperties": false
  }
}
