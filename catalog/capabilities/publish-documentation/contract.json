{
  "execution": "agent",
  "input": {
    "type": "object",
    "properties": {
      "issue": {
        "type": "integer",
        "minimum": 1
      },
      "document": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "issue",
      "document"
    ],
    "additionalProperties": true
  },
  "output": {
    "type": "object",
    "properties": {
      "status": {
        "enum": [
          "published",
          "proposed",
          "blocked"
        ]
      },
      "location": {
        "type": "string"
      },
      "change_record": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      }
    },
    "required": [
      "status",
      "location",
      "change_record",
      "summary"
    ],
    "additionalProperties": false
  }
}
