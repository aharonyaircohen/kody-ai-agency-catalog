{
  "execution": "agent",
  "requirements": { "browser": true, "githubTestToken": true },
  "input": {
    "type": "object",
    "properties": {
      "url": { "type": "string", "format": "uri", "maxLength": 2048 },
      "mode": { "enum": ["read-only", "test"] },
      "scope": { "type": "string", "maxLength": 2000 },
      "authProfile": { "type": "string", "maxLength": 2048 }
    },
    "required": ["url", "mode"],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "scanId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,127}$" },
      "verdict": { "enum": ["pass", "concerns", "fail", "blocked"] },
      "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
      "targetUrl": { "type": "string", "maxLength": 2048 },
      "findings": {
        "type": "array", "maxItems": 100,
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,127}$" },
            "severity": { "enum": ["P0", "P1", "P2", "P3"] },
            "title": { "type": "string", "minLength": 1, "maxLength": 300 },
            "route": { "type": "string", "maxLength": 2048 },
            "steps": { "type": "string", "maxLength": 2000 },
            "expected": { "type": "string", "maxLength": 2000 },
            "actual": { "type": "string", "maxLength": 2000 },
            "evidence": { "type": "string", "maxLength": 2048 }
          },
          "required": ["id", "severity", "title", "route", "steps", "expected", "actual", "evidence"],
          "additionalProperties": false
        }
      },
      "gaps": { "type": "array", "items": { "type": "string", "maxLength": 1000 }, "maxItems": 100 }
    },
    "required": ["scanId", "verdict", "summary", "targetUrl", "findings", "gaps"],
    "additionalProperties": false
  }
}
