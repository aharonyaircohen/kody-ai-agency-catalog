{
  "execution": "agent",
  "deliveryPolicy": "checkpoint",
  "deliveryPathAllowlist": [
    ".github/workflows/**",
    ".kody-engine/definitions/loops/**",
    "kody.config.json"
  ],
  "deliveryConfigAllowlist": {
    "kody.config.json": ["release"]
  },
  "input": {
    "type": "object",
    "properties": {
      "issue": { "type": "integer", "minimum": 1 },
      "pr": { "type": "integer", "minimum": 1 },
      "blueprint": { "type": "object" },
      "instructions": { "type": "string", "minLength": 1 },
      "request": { "type": "object" },
      "installation": { "type": "object" }
    },
    "required": ["blueprint", "instructions", "request"],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "status": { "enum": ["applied", "blocked"] },
      "summary": { "type": "string" },
      "evidence": { "type": "array", "items": { "type": "string" } },
      "reason": { "type": "string" }
    },
    "required": ["status", "summary", "evidence"],
    "additionalProperties": false
  }
}
