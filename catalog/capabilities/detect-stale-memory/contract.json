{
  "execution": "agent",
  "input": {
    "type": "object",
    "properties": {
      "mode": {
        "type": "string",
        "enum": ["repository-memory-quality"]
      }
    },
    "required": ["mode"],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "sourceRunIds": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "candidates": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "candidateId": { "type": "string" },
            "targetMemoryId": { "type": "string" },
            "kind": {
              "type": "string",
              "enum": ["fact", "decision", "goal", "reference"]
            },
            "title": { "type": "string" },
            "summary": { "type": "string" },
            "body": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "evidence": {
              "type": "object",
              "properties": {
                "source": { "const": "engine-run" },
                "id": { "type": "string" }
              },
              "required": ["source", "id"],
              "additionalProperties": false
            }
          },
          "required": [
            "candidateId",
            "targetMemoryId",
            "kind",
            "title",
            "summary",
            "body",
            "confidence",
            "evidence"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": ["sourceRunIds", "candidates"],
    "additionalProperties": false
  }
}
