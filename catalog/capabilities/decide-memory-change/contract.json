{
  "execution": "agent",
  "input": {
    "type": "object",
    "properties": {
      "sourceRunIds": { "type": "array", "items": { "type": "string" } },
      "candidates": { "type": "array", "items": { "type": "object" } },
      "duplicates": { "type": "array", "items": { "type": "object" } },
      "conflicts": { "type": "array", "items": { "type": "object" } }
    },
    "required": ["sourceRunIds", "candidates"],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "sourceRunIds": { "type": "array", "items": { "type": "string" } },
      "decisions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "candidateId": { "type": "string" },
            "action": {
              "type": "string",
              "enum": ["create", "update", "skip"]
            },
            "memoryId": { "type": "string" },
            "kind": {
              "type": "string",
              "enum": ["fact", "decision", "goal", "reference"]
            },
            "title": { "type": "string" },
            "summary": { "type": "string" },
            "body": { "type": "string" },
            "runId": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "reason": { "type": "string" }
          },
          "required": [
            "candidateId",
            "action",
            "runId",
            "confidence",
            "reason"
          ],
          "allOf": [
            {
              "if": {
                "properties": { "action": { "const": "create" } },
                "required": ["action"]
              },
              "then": {
                "properties": {
                  "kind": {},
                  "title": {},
                  "summary": {},
                  "body": {}
                },
                "required": ["kind", "title", "summary", "body"]
              }
            },
            {
              "if": {
                "properties": { "action": { "const": "update" } },
                "required": ["action"]
              },
              "then": {
                "properties": {
                  "memoryId": {},
                  "kind": {},
                  "title": {},
                  "summary": {},
                  "body": {}
                },
                "required": [
                  "memoryId",
                  "kind",
                  "title",
                  "summary",
                  "body"
                ]
              }
            }
          ],
          "additionalProperties": false
        }
      }
    },
    "required": ["sourceRunIds", "decisions"],
    "additionalProperties": false
  }
}
