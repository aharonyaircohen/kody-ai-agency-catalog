{
  "execution": "script",
  "input": {
    "type": "object",
    "properties": {
      "status": { "const": "red" },
      "pr": { "type": ["integer", "null"], "minimum": 1 },
      "branch": { "type": "string", "minLength": 1, "maxLength": 255 },
      "runId": { "type": "integer", "minimum": 1 },
      "headSha": { "type": "string", "minLength": 7, "maxLength": 64 },
      "failedChecks": {
        "type": "array",
        "items": { "type": "string" }
      },
      "runUrl": { "type": "string" },
      "failureLog": { "type": "string", "maxLength": 8000 },
      "summary": { "type": "string" }
    },
    "required": ["status", "failedChecks", "summary"],
    "additionalProperties": true
  },
  "output": {
    "type": "object",
    "properties": {
      "status": { "enum": ["ready", "blocked"] },
      "hasOpenPr": { "type": "boolean" },
      "issue": { "type": "integer", "minimum": 1 },
      "pr": { "type": "integer", "minimum": 1 },
      "prUrl": { "type": "string" },
      "summary": { "type": "string" },
      "report": {
        "type": "object",
        "properties": {
          "whatFailed": { "type": "string" },
          "likelyCause": { "type": "string" },
          "whatItTried": {
            "type": "array",
            "items": { "type": "string" }
          },
          "whyStopped": { "type": "string" },
          "recommendedNextAction": { "type": "string" }
        },
        "required": [
          "whatFailed",
          "likelyCause",
          "whatItTried",
          "whyStopped",
          "recommendedNextAction"
        ],
        "additionalProperties": false
      }
    },
    "required": ["status", "hasOpenPr", "summary"],
    "additionalProperties": false
  }
}
