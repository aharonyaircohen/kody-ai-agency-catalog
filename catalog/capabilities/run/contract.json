{
  "input": {
    "type": "object",
    "properties": {
      "issue": {
        "type": "integer",
        "minimum": 1
      },
      "base": {
        "type": "string"
      }
    },
    "required": [
      "issue"
    ],
    "additionalProperties": true
  },
  "output": {
    "type": "object",
    "properties": {
      "status": {
        "enum": [
          "changed",
          "blocked"
        ]
      },
      "summary": {
        "type": "string"
      },
      "remainingFailures": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "reason": {
        "type": "string"
      }
    },
    "required": [
      "status",
      "summary"
    ],
    "additionalProperties": false
  }
}
