{
  "execution": "agent",
  "deliveryPolicy": "checkpoint",
  "input": {
    "type": "object",
    "properties": {
      "issue": {
        "type": "integer",
        "minimum": 1
      },
      "pr": {
        "type": "integer",
        "minimum": 1
      },
      "runId": {
        "type": "integer",
        "minimum": 1
      },
      "headSha": {
        "type": "string",
        "minLength": 7,
        "maxLength": 64
      },
      "runUrl": {
        "type": "string"
      },
      "failedChecks": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "failureLog": {
        "type": "string",
        "maxLength": 8000
      },
      "failure": {
        "type": "object",
        "properties": {
          "check": { "type": "string" },
          "log": { "type": "string", "maxLength": 8000 },
          "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": ["check", "log", "fingerprint"],
        "additionalProperties": false
      }
    },
    "required": ["runId", "headSha", "failure"],
    "additionalProperties": true
  },
  "output": {
    "type": "object",
    "properties": {
      "status": {
        "enum": ["fixed", "blocked"]
      },
      "pr": {
        "type": "integer",
        "minimum": 1
      },
      "fixed": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "summary": {
        "type": "string"
      },
      "reason": {
        "type": "string"
      },
      "report": {
        "type": "object",
        "properties": {
          "whatFailed": {
            "type": "string"
          },
          "likelyCause": {
            "type": "string"
          },
          "whatItTried": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "whyStopped": {
            "type": "string"
          },
          "recommendedNextAction": {
            "type": "string"
          }
        },
        "required": [
          "whatFailed",
          "likelyCause",
          "whatItTried",
          "whyStopped",
          "recommendedNextAction"
        ],
        "additionalProperties": false
      }
    },
    "required": ["status", "summary", "report"],
    "additionalProperties": false
  }
}
