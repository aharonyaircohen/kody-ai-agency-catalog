{
  "name": "Maintain Memory Quality",
  "agent": "memory-steward",
  "startAt": "stale",
  "steps": [
    {
      "id": "stale",
      "capability": "detect-stale-memory",
      "next": "conflicts"
    },
    {
      "id": "conflicts",
      "capability": "detect-memory-conflicts",
      "next": "decide"
    },
    {
      "id": "decide",
      "capability": "decide-memory-change",
      "next": "apply"
    },
    {
      "id": "apply",
      "capability": "apply-memory-changes",
      "next": "verify"
    },
    {
      "id": "verify",
      "capability": "verify-memory-change"
    }
  ]
}
