{
  "name": "Chore Flow",
  "capabilities": [
    "run",
    "review"
  ],
  "startAt": "run",
  "steps": [
    {
      "id": "run",
      "capability": "run",
      "target": "issue",
      "delivery": "pull-request",
      "reason": "Complete the scoped chore, verify it, and open or update the pull request.",
      "next": "review"
    },
    {
      "id": "review",
      "capability": "review",
      "target": "pr",
      "reason": "Review the generated pull request before calling the chore flow complete.",
      "next": [
        {
          "to": "$end",
          "when": {
            "result.verdict": "pass"
          }
        },
        {
          "to": "run",
          "default": true,
          "maxIterations": 3
        }
      ]
    }
  ],
  "agent": "kody"
}
