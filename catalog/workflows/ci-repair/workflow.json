{
  "name": "CI Repair",
  "agent": "kody",
  "runWithoutApproval": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "pr": {
        "type": "integer",
        "minimum": 1
      },
      "runId": {
        "type": "integer",
        "minimum": 1
      },
      "headSha": {
        "type": "string",
        "minLength": 7,
        "maxLength": 64
      }
    },
    "required": ["pr", "runId", "headSha"],
    "additionalProperties": false
  },
  "startAt": "check",
  "steps": [
    {
      "id": "check",
      "capability": "ci-health-check",
      "inputs": {
        "pr": { "from": "workflow.input.pr" }
      },
      "target": "pr",
      "next": [
        {
          "to": "fix",
          "when": {
            "result.needsRepair": true
          }
        },
        {
          "to": "$end",
          "default": true
        }
      ]
    },
    {
      "id": "fix",
      "capability": "fix-ci",
      "inputs": {
        "pr": { "from": "workflow.input.pr" },
        "runId": { "from": "steps.check.result.runId" },
        "headSha": { "from": "workflow.input.headSha" },
        "runUrl": { "from": "steps.check.result.runUrl" },
        "failedChecks": { "from": "steps.check.result.failedChecks" },
        "failureLog": { "from": "steps.check.result.failureLog" }
      },
      "target": "pr",
      "delivery": "pull-request"
    }
  ]
}
