{
  "name": "CI Repair",
  "agent": "kody",
  "runWithoutApproval": true,
  "startAt": "check",
  "steps": [
    {
      "id": "check",
      "capability": "ci-health-check",
      "next": [
        {
          "to": "prepare",
          "when": {
            "result.needsRepair": true
          }
        },
        {
          "to": "$end",
          "default": true
        }
      ]
    },
    {
      "id": "prepare",
      "capability": "prepare-ci-repair",
      "next": [
        {
          "to": "$end",
          "when": {
            "result.status": "blocked"
          }
        },
        {
          "to": "check-pr",
          "when": {
            "result.hasOpenPr": true
          }
        },
        {
          "to": "repair",
          "default": true
        }
      ]
    },
    {
      "id": "repair",
      "capability": "run",
      "target": "issue",
      "targetFact": "issue",
      "delivery": "pull-request",
      "next": "check-pr"
    },
    {
      "id": "check-pr",
      "capability": "ci-health-check",
      "target": "pr",
      "targetFact": "pr",
      "next": [
        {
          "to": "fix",
          "when": {
            "result.status": "red"
          }
        },
        {
          "to": "$end",
          "when": {
            "result.status": "blocked"
          }
        },
        {
          "to": "$end",
          "default": true
        }
      ]
    },
    {
      "id": "fix",
      "capability": "fix",
      "target": "pr",
      "delivery": "pull-request",
      "next": [
        {
          "to": "$end",
          "when": {
            "result.status": "blocked"
          }
        },
        {
          "to": "check-pr",
          "default": true,
          "maxIterations": 3
        }
      ]
    }
  ]
}
