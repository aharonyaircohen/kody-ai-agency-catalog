{
  "name": "Review and Merge",
  "createdAt": "2026-08-08T00:00:00Z",
  "updatedAt": "2026-08-08T13:15:00Z",
  "inputSchema": {
    "type": "object",
    "properties": {
      "pr": {
        "type": "integer",
        "minimum": 1
      },
      "headSha": {
        "type": "string",
        "minLength": 7,
        "maxLength": 64
      }
    },
    "required": ["pr"],
    "additionalProperties": false
  },
  "startAt": "check-pr",
  "steps": [
    {
      "id": "check-pr",
      "capability": "ci-health-check",
      "target": "pr",
      "next": [
        {
          "to": "review",
          "when": {
            "result.status": "healthy"
          }
        },
        {
          "to": "$end",
          "default": true
        }
      ]
    },
    {
      "id": "review",
      "capability": "review",
      "target": "pr",
      "next": [
        {
          "to": "ui-review",
          "when": {
            "result.verdict": "pass"
          }
        },
        {
          "to": "fix",
          "when": {
            "result.verdict": "fix"
          }
        },
        {
          "to": "$end",
          "default": true
        }
      ]
    },
    {
      "id": "ui-review",
      "capability": "ui-review",
      "target": "pr",
      "next": [
        {
          "to": "merge",
          "when": {
            "result.verdict": "pass"
          }
        },
        {
          "to": "fix",
          "when": {
            "result.verdict": "fix"
          }
        },
        {
          "to": "$end",
          "default": true
        }
      ]
    },
    {
      "id": "fix",
      "capability": "fix",
      "target": "pr",
      "delivery": "pull-request",
      "next": [
        {
          "to": "$end",
          "when": {
            "result.status": "blocked"
          }
        },
        {
          "to": "check-pr",
          "default": true,
          "maxIterations": 3
        }
      ]
    },
    {
      "id": "merge",
      "capability": "merge",
      "target": "pr"
    }
  ],
  "agent": "kody"
}
