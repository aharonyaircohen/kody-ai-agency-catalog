{
  "id": "ci-repair-on-ci-cancelled",
  "name": "Run CI Repair when CI is cancelled",
  "enabled": true,
  "event": "github.workflow_run.completed",
  "conditions": [
    {
      "path": "conclusion",
      "op": "equals",
      "value": "cancelled"
    }
  ],
  "action": {
    "type": "start-pipeline",
    "pipelineId": "ci-repair",
    "inputMap": {
      "pr": "payload.pr",
      "branch": "payload.branch",
      "runId": "payload.runId",
      "headSha": "payload.headSha"
    }
  }
}
